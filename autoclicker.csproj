<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>autoclicker</AssemblyName>
    <RootNamespace>AutoClicker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.2</Version>
    <Product>Автокликер</Product>
    <Description>Оконный и консольный автокликер для Windows на Win32 SendInput</Description>

    <!-- Одна команда `dotnet publish -c Release` уже даёт единственный переносимый exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>dist\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- В publish не кладём ни .pdb, ни что-либо ещё: в папке должен лежать ровно один файл. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
